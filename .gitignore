# --- Generated data & model artifacts ---
# Ignore the contents but keep the directories, so a fresh clone has somewhere
# for `sentinel gen` and `sentinel train` to write.
data/*
artifacts/*
!data/.gitkeep
!artifacts/.gitkeep
*.parquet
*.joblib
*.pt
*.pth

# --- Reports: keep the markdown, ignore rendered output ---
reports/*.png
reports/*.pdf
reports/*.svg

